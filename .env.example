# =====================================================================
#  PLANTILLA DE CLAVES DE indumen2k
# ---------------------------------------------------------------------
#  1. Copiá este archivo y llamá a la copia ".env" (sin "example").
#  2. Pegá tus claves en el ".env" (NO en este archivo).
#  3. El ".env" está bloqueado: nunca se sube a GitHub.
#  Cómo conseguir cada clave: ver docs/CLAVES.md
# =====================================================================

# Modo de la tienda: "test" (prueba, no se cobra nada) o "production".
# ⚠️ NO cambiar a production hasta que lo decidamos juntos.
STORE_MODE=test

# Para probar en tu compu como si fueras de otro país: US, AR o ES (España).
# (Cuando la web esté publicada, el país se detecta solo).
DEV_COUNTRY=US

# --- CJ Dropshipping (proveedor) -------------------- etapa 2 ---
CJ_API_KEY=

# --- PayPal (EE.UU. y Europa) — claves de SANDBOX ---- etapa 3 ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Mercado Pago (Argentina) — credenciales de PRUEBA -- más adelante ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# --- Stripe (opcional, a futuro) -------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Mails de aviso (Resend) ------------------------- etapa 4 ---
RESEND_API_KEY=
# Tu mail: ahí te llegan los avisos de pedidos para aprobar
ADMIN_EMAIL=

# --- Base de datos para guardar pedidos -------------- etapa 4 ---
DATABASE_URL=

# --- Contraseña del panel donde aprobás pedidos ------ etapa 4 ---
ADMIN_PASSWORD=
