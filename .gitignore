# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ⚠️ IMPORTANTE: los archivos .env tienen tus claves secretas.
# La línea ".env*" de arriba hace que NUNCA se suban a GitHub.
# La única excepción es .env.example, que es una plantilla SIN claves reales.
!.env.example

# Pase de acceso de CJ (es secreto) e informes del comparador
.cj-token.json
/informes/
